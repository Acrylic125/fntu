{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fntu-api",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-11-21",
  "ratelimits": [
    {
      "name": "SIMPLE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
  },
  // "compatibility_flags": [
